# Application
NODE_ENV="development"
NEXT_PUBLIC_SHOW_LOGGER="true"
NEXTAUTH_URL="http://localhost:3000"
# Generate locally with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# PostgreSQL (local development only)
DB_PORT=5432
DB_DATABASE="special_chainsaw"
DB_USERNAME="app"
DB_PASSWORD="replace-for-local-development"
DB_PRISMA_URL="postgresql://app:replace-for-local-development@localhost:5432/special_chainsaw?schema=public"
DB_URL_NON_POOLING="postgresql://app:replace-for-local-development@localhost:5432/special_chainsaw?schema=public"

# MQTT (supply real values only in the ignored .env file)
MQTT_HOST="mqtt://localhost"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_PORT=1883
MQTT_TOPIC="hackeps/local-demo"
